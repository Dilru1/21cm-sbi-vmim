# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store

# ---- Cluster job logs (churn every run; keep out of git) ----
logs/
*.out
*.err
slurm-*.out


docs/GUIDE.md
docs/MLOPS.md

# ---- Heavy cosmological data & simulation outputs (keep out of git) ----
data/
*.h5
*.fits
*.npy
*.npz
*.pt
*.ckpt
*.dat

# ---- Generated analysis outputs ----
# (large report trees written to scratch or regenerated from code)
eval_reports/
new_plots/
noise_ana/
sum_out/

# ---- Allow small, curated outputs that ARE useful to track ----
# (negations must come after the broad rules above)
!SBC_OUT/**
!SBC_OUTPUT/**
!**/metrics.json
!**/metrics.csv
!**/metrics.tex
!nle_training_comparison.png
!nle_training_comparison_mse.png
_build/
node_modules/
