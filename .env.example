# Copy to .env (git-ignored) and `source .env`, or export these in your SLURM
# script. None are required -- the pipeline runs without any of them.

# --- Experiment tracking (Weights & Biases) ---
# Get a key at https://wandb.ai/authorize (free academic Pro tier available).
# export WANDB_API_KEY=...
export WANDB_PROJECT=21cm-sbi-vmim
# On compute nodes with NO outbound internet, log to disk and sync later:
#   export WANDB_MODE=offline      # in the SLURM job
#   wandb sync <run-dir>           # afterwards, from a login node
# export WANDB_MODE=offline

# --- Kill switch: set to 0 to disable all tracking (provenance still written) ---
export SBI_TRACK=1
